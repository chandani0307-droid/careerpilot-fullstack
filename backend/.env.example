# Copy to .env. Everything is optional — with nothing set the API uses a
# local SQLite file and offline templates. 100% free: no job-search key exists.
# GEMINI_API_KEY is only an optional SHARED fallback. Each user can also enter
# their OWN free Gemini key on the Settings page — that key is encrypted in
# the database and only ever used for that user's own AI calls.
DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DAILY_AI_LIMIT=40
SECRET_KEY=change-this-to-a-long-random-string
JOB_RSS_FEEDS=https://weworkremotely.com/categories/remote-programming-jobs.rss,https://weworkremotely.com/categories/remote-data-science-jobs.rss,https://remoteok.com/rss
MOCK_JOBS_FALLBACK=true
